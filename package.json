{
  "name": "magnetic-localization-observatory",
  "version": "0.1.0",
  "private": true,
  "description": "An interactive synthetic magnetic dipole and sensor-array observatory.",
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=22" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "node scripts/generate-notices.mjs && tsc --noEmit && vite build && node scripts/check-release.mjs",
    "preview": "vite preview --host 127.0.0.1",
    "test": "vitest run",
    "test:ui": "node scripts/browser-check.mjs",
    "check:release": "node scripts/check-release.mjs"
  },
  "dependencies": {
    "@react-three/drei": "10.7.6",
    "@react-three/fiber": "9.4.0",
    "lucide-react": "0.468.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "three": "0.180.0",
    "uplot": "1.6.32"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.19.2",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  }
}
